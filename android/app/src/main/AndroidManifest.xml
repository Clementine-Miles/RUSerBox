<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- File transfers use app-specific storage and Android's document picker.
         QR scanning uses the camera with audio disabled. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: the transfer notification asks to be
         promoted (`TransferNotification`). A normal permission. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Guards the in-process broadcast the notification's "Stop All" action
         sends. `RECEIVER_NOT_EXPORTED` only exists from API 33, so on anything
         older the dynamically registered receiver was reachable by any app on
         the device — and its one action disconnects every SSH session. Signature
         level, so only a build signed with this key can send it. -->
    <permission
        android:name="tech.lolli.toolbox.permission.INTERNAL_BROADCAST"
        android:protectionLevel="signature" />
    <uses-permission android:name="tech.lolli.toolbox.permission.INTERNAL_BROADCAST" />

    <!-- The database is encrypted with a random key held by Android's
         device-bound secure storage. Auto Backup can restore the database on
         another device without restoring that key, producing data the app can
         never decrypt. Credentials also do not belong in an OS backup.
         Cross-device recovery is the app's encrypted export. -->

    <application
        android:supportsRtl="true"
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="true"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="tiramisu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|locale|layoutDirection|fontScale|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
            />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- `serverbox://` links: see `AppLink` in
                 lib/data/model/app/app_link.dart. MainActivity holds the link
                 until the Dart side asks for it. By host, the hosts `AppLink`
                 knows: `serverbox://auth/callback` is AppAuth's sign-in
                 redirect, and a link two activities take asks which one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="serverbox" />
                <data android:host="server" />
                <data android:host="add-server" />
                <data android:host="tab" />
                <data android:host="snippet" />
            </intent-filter>
            <!-- Off, or Flutter pushes every link it sees as a route name onto
                 a navigator that has no generator for one. Links are taken in
                 by MainActivity instead. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <!--
                No file association on Android, deliberately.

                Verified on an emulator rather than reasoned about: a filter
                gated on `pathPattern` does resolve for `file:///...sbxsrv`
                and correctly refuses `other.bin`, but the app then cannot
                *read* it. A raw path in shared storage needs a storage
                permission this app does not have and should not ask for:
                `open failed: EACCES`. And since Android 7 a `file://` URI
                thrown across apps raises `FileUriExposedException`, so no
                real file manager sends one anyway; they send `content://`,
                whose path is opaque and never matches a `pathPattern`.

                So the filter matched only what nothing sends and could not
                read it, while what is actually sent it did not match.
                Dropping `pathPattern` to catch `content://` would mean
                claiming `application/octet-stream`, which puts ServerBox in
                the "open with" list of every unknown binary on the device.

                A shared server comes in through the add button on the server
                list instead. That goes through the system file picker, which
                hands back a URI this app is granted, which is the case that works.
            -->
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <service
            android:name=".ForegroundService"
            android:enabled="true"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Shares and selected text from other apps (`IncomingActivity`),
             apart from MainActivity so they never start a second one in the
             sender's task. Shared text becomes a snippet draft, shared files
             go wherever the user picks; `IncomingFiles` refuses `file://` and
             this app's own providers. -->
        <activity
            android:name=".incoming.IncomingActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.AppCompat.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Exported as a tile service has to be, and guarded by the
             permission only System UI holds. -->
        <service
            android:name=".SessionsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_terminal"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- The Linux systems in the system file picker (#1583). Exported, as
             a documents provider has to be, and guarded by MANAGE_DOCUMENTS,
             which only the system's picker holds: another app reaches a file
             here only after the user picks it there. -->
        <provider
            android:name=".linux.LinuxDocumentsProvider"
            android:authorities="${applicationId}.linux"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- AppAuth's own filter takes every `serverbox://` link; this one,
             only the sign-in redirect (`Lkc.redirectUrl`). -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Translucent.NoTitleBar"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="serverbox"
                    android:host="auth"
                    android:path="/callback" />
            </intent-filter>
        </activity>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility?hl=en and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
