<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">Сохранить как фрагмент кода</string>
    <string name="tile_no_sessions">Нет запущенных сеансов</string>
    <plurals name="tile_sessions">
        <item quantity="one">%d сеанс</item>
        <item quantity="few">%d сеанса</item>
        <item quantity="many">%d сеансов</item>
        <item quantity="other">%d сеанса</item>
    </plurals>
    <string name="channel_transfers">Передача файлов</string>
    <string name="incoming_failed">Не удалось принять файлы</string>
    <string name="shortcut_server_gone">Сервер удалён</string>
    <string name="notification_disconnect_all">Отключить все</string>
    <string name="session_connected">Подключено</string>
    <string name="session_connecting">Подключение</string>
    <string name="session_disconnected">Отключено</string>
    <plurals name="notification_more">
        <item quantity="one">…и ещё %d</item>
        <item quantity="few">…и ещё %d</item>
        <item quantity="many">…и ещё %d</item>
        <item quantity="other">…и ещё %d</item>
    </plurals>
</resources>
