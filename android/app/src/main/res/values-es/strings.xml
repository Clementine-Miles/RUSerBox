<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">Guardar como fragmento de código</string>
    <string name="tile_no_sessions">No hay sesiones en ejecución</string>
    <plurals name="tile_sessions">
        <item quantity="one">%d sesión</item>
        <item quantity="other">%d sesiones</item>
    </plurals>
    <string name="channel_transfers">Transferencias de archivos</string>
    <string name="incoming_failed">No se pudieron recibir los archivos compartidos</string>
    <string name="shortcut_server_gone">Servidor eliminado</string>
    <string name="notification_disconnect_all">Desconectar todo</string>
    <string name="session_connected">Conectado</string>
    <string name="session_connecting">Conectando</string>
    <string name="session_disconnected">Desconectado</string>
    <plurals name="notification_more">
        <item quantity="one">…y %d más</item>
        <item quantity="other">…y %d más</item>
    </plurals>
</resources>
