<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">Enregistrer comme extrait de code</string>
    <string name="tile_no_sessions">Aucune session en cours</string>
    <plurals name="tile_sessions">
        <item quantity="one">%d session</item>
        <item quantity="other">%d sessions</item>
    </plurals>
    <string name="channel_transfers">Transferts de fichiers</string>
    <string name="incoming_failed">Impossible de recevoir les fichiers partagés</string>
    <string name="shortcut_server_gone">Serveur supprimé</string>
    <string name="notification_disconnect_all">Tout déconnecter</string>
    <string name="session_connected">Connecté</string>
    <string name="session_connecting">Connexion en cours</string>
    <string name="session_disconnected">Déconnecté</string>
    <plurals name="notification_more">
        <item quantity="one">…et %d de plus</item>
        <item quantity="other">…et %d de plus</item>
    </plurals>
</resources>
