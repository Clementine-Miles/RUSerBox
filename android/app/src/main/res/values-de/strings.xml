<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">Als Code-Snippet speichern</string>
    <string name="tile_no_sessions">Keine laufenden Sitzungen</string>
    <plurals name="tile_sessions">
        <item quantity="one">%d Sitzung</item>
        <item quantity="other">%d Sitzungen</item>
    </plurals>
    <string name="channel_transfers">Dateiübertragungen</string>
    <string name="incoming_failed">Geteilte Dateien konnten nicht übernommen werden</string>
    <string name="shortcut_server_gone">Server entfernt</string>
    <string name="notification_disconnect_all">Alle trennen</string>
    <string name="session_connected">Verbunden</string>
    <string name="session_connecting">Verbindung wird hergestellt</string>
    <string name="session_disconnected">Getrennt</string>
    <plurals name="notification_more">
        <item quantity="one">…und %d weitere</item>
        <item quantity="other">…und %d weitere</item>
    </plurals>
</resources>
