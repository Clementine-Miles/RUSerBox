<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">保存为代码片段</string>
    <string name="tile_no_sessions">没有正在运行的会话</string>
    <plurals name="tile_sessions">
        <item quantity="other">%d 个会话</item>
    </plurals>
    <string name="channel_transfers">文件传输</string>
    <string name="incoming_failed">无法接收分享的文件</string>
    <string name="shortcut_server_gone">服务器已删除</string>
    <string name="notification_disconnect_all">全部断开</string>
    <string name="session_connected">已连接</string>
    <string name="session_connecting">正在连接</string>
    <string name="session_disconnected">已断开连接</string>
    <plurals name="notification_more">
        <item quantity="other">…还有 %d 个</item>
    </plurals>
</resources>
