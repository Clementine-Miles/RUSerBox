        <item quantity="other">%d 個工作階段</item>
    </plurals>
    <string name="channel_transfers">檔案傳輸</string>
    <string name="incoming_failed">無法接收分享的檔案</string>
    <string name="shortcut_server_gone">伺服器已刪除</string>
    <string name="notification_disconnect_all">全部斷開</string>
    <string name="session_connected">已連線</string>
    <string name="session_connecting">正在連線</string>
    <string name="session_disconnected">已中斷連線</string>
    <plurals name="notification_more">
        <item quantity="other">…還有 %d 個</item>
    </plurals>
</resources>
