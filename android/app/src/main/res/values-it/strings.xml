<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">Salva come snippet di codice</string>
    <string name="tile_no_sessions">Nessuna sessione in corso</string>
    <plurals name="tile_sessions">
        <item quantity="one">%d sessione</item>
        <item quantity="other">%d sessioni</item>
    </plurals>
    <string name="channel_transfers">Trasferimenti di file</string>
    <string name="incoming_failed">Impossibile ricevere i file condivisi</string>
    <string name="shortcut_server_gone">Server rimosso</string>
    <string name="notification_disconnect_all">Disconnetti tutti</string>
    <string name="session_connected">Connesso</string>
    <string name="session_connecting">Connessione in corso</string>
    <string name="session_disconnected">Disconnesso</string>
    <plurals name="notification_more">
        <item quantity="one">…e altri %d</item>
        <item quantity="other">…e altri %d</item>
    </plurals>
</resources>
