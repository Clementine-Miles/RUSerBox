<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">Als codefragment opslaan</string>
    <string name="tile_no_sessions">Er zijn geen actieve sessies</string>
    <plurals name="tile_sessions">
        <item quantity="one">%d sessie</item>
        <item quantity="other">%d sessies</item>
    </plurals>
    <string name="channel_transfers">Bestandsoverdrachten</string>
    <string name="incoming_failed">Gedeelde bestanden konden niet worden ontvangen</string>
    <string name="shortcut_server_gone">Server verwijderd</string>
    <string name="notification_disconnect_all">Alles verbreken</string>
    <string name="session_connected">Verbonden</string>
    <string name="session_connecting">Verbinden</string>
    <string name="session_disconnected">Verbinding verbroken</string>
    <plurals name="notification_more">
        <item quantity="one">…en nog %d</item>
        <item quantity="other">…en nog %d</item>
    </plurals>
</resources>
