<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">Зберегти як фрагмент коду</string>
    <string name="tile_no_sessions">Немає запущених сеансів</string>
    <plurals name="tile_sessions">
        <item quantity="one">%d сеанс</item>
        <item quantity="few">%d сеанси</item>
        <item quantity="many">%d сеансів</item>
        <item quantity="other">%d сеансу</item>
    </plurals>
    <string name="channel_transfers">Передавання файлів</string>
    <string name="incoming_failed">Не вдалося прийняти файли</string>
    <string name="shortcut_server_gone">Сервер видалено</string>
    <string name="notification_disconnect_all">Відключити всі</string>
    <string name="session_connected">Підключено</string>
    <string name="session_connecting">Підключення</string>
    <string name="session_disconnected">Відключено</string>
    <plurals name="notification_more">
        <item quantity="one">…і ще %d</item>
        <item quantity="few">…і ще %d</item>
        <item quantity="many">…і ще %d</item>
        <item quantity="other">…і ще %d</item>
    </plurals>
</resources>
