<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">Salvar como snippet de código</string>
    <string name="tile_no_sessions">Nenhuma sessão ativa</string>
    <plurals name="tile_sessions">
        <item quantity="one">%d sessão</item>
        <item quantity="other">%d sessões</item>
    </plurals>
    <string name="channel_transfers">Transferências de arquivos</string>
    <string name="incoming_failed">Não foi possível receber os arquivos compartilhados</string>
    <string name="shortcut_server_gone">Servidor removido</string>
    <string name="notification_disconnect_all">Desconectar tudo</string>
    <string name="session_connected">Conectado</string>
    <string name="session_connecting">Conectando</string>
    <string name="session_disconnected">Desconectado</string>
    <plurals name="notification_more">
        <item quantity="one">…e mais %d</item>
        <item quantity="other">…e mais %d</item>
    </plurals>
</resources>
