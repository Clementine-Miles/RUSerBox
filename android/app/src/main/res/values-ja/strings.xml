<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">コードコードスニペットとして保存</string>
    <string name="tile_no_sessions">実行中のセッションはありません</string>
    <plurals name="tile_sessions">
        <item quantity="other">%d 件のセッション</item>
    </plurals>
    <string name="channel_transfers">ファイル転送</string>
    <string name="incoming_failed">共有されたファイルを受け取れませんでした</string>
    <string name="shortcut_server_gone">サーバーは削除されました</string>
    <string name="notification_disconnect_all">すべて切断</string>
    <string name="session_connected">接続済み</string>
    <string name="session_connecting">接続中</string>
    <string name="session_disconnected">切断</string>
    <plurals name="notification_more">
        <item quantity="other">…他 %d 件</item>
    </plurals>
</resources>
