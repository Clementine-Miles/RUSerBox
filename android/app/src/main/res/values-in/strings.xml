<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget strings only. Everything the Flutter side owns stays in its
    ARB files; these are drawn by native code in a process the Flutter
    engine may never have started in, so `l10n` is not reachable.

    Indonesian is `values-in`, not `values-id`: resource qualifiers use
    the legacy ISO code, which is what `Locale.getLanguage()` returns
    on every Android version.
-->
<resources>

    <string name="process_text_label">Simpan sebagai cuplikan kode</string>
    <string name="tile_no_sessions">Tidak ada sesi yang sedang berjalan</string>
    <plurals name="tile_sessions">
        <item quantity="other">%d sesi</item>
    </plurals>
    <string name="channel_transfers">Transfer file</string>
    <string name="incoming_failed">Tidak dapat menerima file yang dibagikan</string>
    <string name="shortcut_server_gone">Server dihapus</string>
    <string name="notification_disconnect_all">Putuskan semua</string>
    <string name="session_connected">Terhubung</string>
    <string name="session_connecting">Menghubungkan</string>
    <string name="session_disconnected">Terputus</string>
    <plurals name="notification_more">
        <item quantity="other">…dan %d lainnya</item>
    </plurals>
</resources>
