        <item quantity="other">세션 %d개</item>
    </plurals>
    <string name="channel_transfers">파일 전송</string>
    <string name="incoming_failed">공유된 파일을 받을 수 없습니다</string>
    <string name="shortcut_server_gone">서버가 삭제됨</string>
    <string name="notification_disconnect_all">모두 연결 해제</string>
